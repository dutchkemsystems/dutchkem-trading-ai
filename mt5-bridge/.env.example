# =============================================================================
# Dutchkem Trading AI — MT5 Bridge Environment Variables
# =============================================================================
# Copy this file to .env and fill in your MT5 credentials.
#
# The MT5 terminal must be running on the Windows host machine.
# The bridge container connects to it via host.docker.internal:1929.
# =============================================================================

# MT5 Terminal connection (host.docker.internal resolves to the Windows host)
MT5_HOST=host.docker.internal
MT5_PORT=1929

# MT5 Terminal Credentials (MUST match your running MT5 terminal)
MT5_LOGIN=YOUR_MT5_LOGIN
MT5_PASSWORD=YOUR_MT5_PASSWORD
MT5_SERVER=YOUR_MT5_SERVER

# Logging
LOG_LEVEL=info

# Cloudflare Tunnel (optional — only used with docker compose --profile tunnel)
# CLOUDFLARE_TUNNEL_TOKEN=your-cloudflare-tunnel-token
