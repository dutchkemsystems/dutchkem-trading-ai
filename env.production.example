# =============================================================================
# Dutchkem Trading AI — Production Environment Variables
# =============================================================================
# Used by Render and other production hosts.
# Render: paste values into the Render dashboard or link to this file.
#
# MINIMUM REQUIRED VARS (must be set):
#   SECRET_KEY, DATABASE_URL, REDIS_URL, CELERY_BROKER_URL,
#   MT5_HOST, MT5_PORT, MT5_WS_PORT, MT5_LOGIN, MT5_PASSWORD, MT5_SERVER
# =============================================================================

# --- Django Core ----------------------------------------------------------------
SECRET_KEY=generate-a-50-char-random-string
DEBUG=0
DJANGO_SETTINGS_MODULE=config.settings_production

# --- Database -------------------------------------------------------------------
# Render auto-injects DATABASE_URL when linked to a PostgreSQL database.
# For non-Render: set to your PostgreSQL connection string.
USE_SQLITE=0
DATABASE_URL=postgresql://user:pass@host:5432/dutchkem_trading

# --- Redis / Celery -------------------------------------------------------------
# Create Redis in Render dashboard -> Environment -> Redis -> paste Internal URL.
# Celery worker and beat WILL NOT START without these.
REDIS_URL=redis://your-redis-url:6379/0
CELERY_BROKER_URL=redis://your-redis-url:6379/1

# --- MetaTrader 5 (SYNX-MT5-MCP bridge) ----------------------------------------
# Cloud deployment: Use Cloudflare Tunnel URL (https://mt5.yourdomain.com)
# Local Docker: Use host.docker.internal with mapped ports
#
# IMPORTANT: MT5_PORT and MT5_WS_PORT are the EXTERNAL ports the bridge exposes.
#   - If using Cloudflare Tunnel: both are 443
#   - If Docker with port mapping: 8082 (REST) and 8081 (WebSocket)
#   - NEVER set to 3000/3001 (those are internal container ports)
MT5_HOST=your-mt5-bridge.your-domain.com
MT5_PORT=443
MT5_WS_PORT=443
MT5_TIMEOUT=10
MT5_MAX_RETRIES=5
MT5_RETRY_DELAY=2.0

# MT5 Terminal credentials (for bridge to connect to your MT5 terminal)
MT5_LOGIN=your_mt5_account_number
MT5_PASSWORD=your_mt5_password
MT5_SERVER=your_broker_server_name

# --- Trading Configuration ------------------------------------------------------
# full = automatic trading (no approval needed)
# semi = semi-automatic (requires manual approval)
# manual = no automatic trades
TRADING_MODE=full

# --- Cloudinary (optional — media storage) --------------------------------------
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- Payments (Korapay) ---------------------------------------------------------
KORA_SECRET_KEY=
KORA_ENCRYPTION_KEY=
KORA_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_PUBLIC_KEY=
KORA_WEBHOOK_SECRET=

# --- Production Security --------------------------------------------------------
SECURE_SSL_REDIRECT=1
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1
ALLOWED_HOSTS=dutchkem-trading-ai.onrender.com
CORS_ALLOWED_ORIGINS=https://dutchkem-trading-ai-frontend.onrender.com
CSRF_TRUSTED_ORIGINS=https://dutchkem-trading-ai.onrender.com
