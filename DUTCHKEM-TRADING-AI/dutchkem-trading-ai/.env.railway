# Railway Deployment — Environment Variables
# Copy these to Railway Dashboard > Variables

# Django
SECRET_KEY=your-super-secret-key-change-this
DEBUG=False
ALLOWED_HOSTS=*.railway.app,*.up.railway.app
CORS_ALLOWED_ORIGINS=https://your-app.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-app.up.railway.app

# PostgreSQL (Railway provides this automatically when you add a PostgreSQL plugin)
# Railway sets DATABASE_URL automatically — no need to set DB_* vars manually

# Redis (Railway provides this when you add a Redis plugin)
# Railway sets REDIS_URL automatically

# Celery Broker (use Railway Redis)
CELERY_BROKER_URL=redis://:${REDIS_URL}

# InfluxDB (external — use InfluxCloud free tier)
INFLUXDB_URL=https://us-west-2-1.aws.cloud2.influxdata.com
INFLUXDB_TOKEN=your-token
INFLUXDB_ORG=dutchkem
INFLUXDB_BUCKET=market_data

# MT5
MT5_HOST=your-mt5-server
MT5_PORT=1985

# Stripe
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_PUBLISHABLE_KEY=pk_live_xxx

# SMTP (use Gmail app password or SendGrid)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
