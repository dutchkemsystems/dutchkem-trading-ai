# RaidFrame / Railway Deployment — Environment Variables
# Set these in Railway Dashboard > Service > Variables

# Django Core
SECRET_KEY=generate-a-real-secret-key
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings_production
ALLOWED_HOSTS=*.railway.app,*.up.railway.app

# PostgreSQL (Railway plugin provides DATABASE_URL automatically)
# DATABASE_URL is auto-set by Railway PostgreSQL plugin

# Redis (Railway plugin provides REDIS_URL automatically)
# REDIS_URL is auto-set by Railway Redis plugin

# CORS — set your frontend domain
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app
CSRF_TRUSTED_ORIGINS=https://your-frontend.up.railway.app

# Celery uses Redis as broker
CELERY_BROKER_URL=${REDIS_URL}

# InfluxDB (use InfluxCloud free tier)
INFLUXDB_URL=https://us-west-2-1.aws.cloud2.influxdata.com
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=dutchkem
INFLUXDB_BUCKET=market_data

# MT5
MT5_HOST=your-mt5-server-ip
MT5_PORT=1985

# Korapay
KORA_SECRET_KEY=your-korapay-secret-key
KORA_ENCRYPTION_KEY=your-korapay-encryption-key
KORA_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_PUBLIC_KEY=your-korapay-public-key
KORA_WEBHOOK_SECRET=your-korapay-webhook-secret

# SMTP
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# Twilio
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Firebase
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PASSWORD=admin
