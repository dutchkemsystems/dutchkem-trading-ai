{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "dutchkem-trading-ai-frontend",
  "framework": "create-react-app",
  "buildCommand": "npm run build",
  "outputDirectory": "build",
  "installCommand": "npm install",
  "regions": ["iad1"],

  "rewrites": [
    {
      "source": "/static/:path*",
      "destination": "/static/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://dutchkem-api.onrender.com/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://dutchkem-api.onrender.com/health/:path*"
    },
    {
      "source": "/ws/:path*",
      "destination": "wss://dutchkem-api.onrender.com/ws/:path*"
    },
    {
      "source": "/((?!static|api|health|ws|favicon|manifest|logo).*)",
      "destination": "/index.html"
    }
  ],

  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "X-XSS-Protection", "value": "1; mode=block" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],

  "env": {
    "REACT_APP_API_URL": "https://dutchkem-api.onrender.com",
    "REACT_APP_WS_URL": "wss://dutchkem-api.onrender.com/ws",
    "GENERATE_SOURCEMAP": "false"
  }
}
