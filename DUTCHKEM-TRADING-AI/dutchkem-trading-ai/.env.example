# Dutchkem Trading AI — Complete Environment Variables Template
# Copy this file to .env and fill in all values for your environment

# =============================================================================
# DJANGO CORE
# =============================================================================
SECRET_KEY=your-super-secret-key-change-this-in-production-minimum-50-chars
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings_production
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# DATABASE (PostgreSQL / TimescaleDB)
# =============================================================================
# Option 1: Individual variables (for Docker Compose)
DB_NAME=dutchkem_trading
DB_USER=dutchkem_admin
DB_PASSWORD=CHANGE_THIS_STRONG_PASSWORD
DB_HOST=localhost
DB_PORT=5432

# Option 2: Full connection string (for Railway / Heroku / cloud providers)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# =============================================================================
# REDIS
# =============================================================================
REDIS_URL=redis://localhost:6379/0
# For password-protected Redis:
# REDIS_URL=redis://:password@localhost:6379/0
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD

# =============================================================================
# CELERY (Message Broker)
# =============================================================================
CELERY_BROKER_URL=amqp://dutchkem:CHANGE_THIS@localhost:5672/
RABBITMQ_USER=dutchkem
RABBITMQ_PASS=CHANGE_THIS_RABBITMQ_PASSWORD

# =============================================================================
# CORS & CSRF
# =============================================================================
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# =============================================================================
# INFLUXDB (Time-Series Data)
# =============================================================================
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=dutchkem
INFLUXDB_BUCKET=trading_data
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=CHANGE_THIS_INFLUX_PASSWORD

# =============================================================================
# METATRADER 5 (SYNX-MT5-MCP Bridge)
# =============================================================================
MT5_HOST=your-mt5-server-ip
MT5_PORT=3000
MT5_WS_PORT=3001
MT5_TIMEOUT=10
MT5_MAX_RETRIES=5
MT5_RETRY_DELAY=2.0

# =============================================================================
# KORAPAY (Payment Gateway)
# =============================================================================
KORA_SECRET_KEY=your-korapay-secret-key
KORA_PUBLIC_KEY=your-korapay-public-key
KORA_ENCRYPTION_KEY=your-korapay-encryption-key
KORA_WEBHOOK_SECRET=your-korapay-webhook-secret
KORA_BASE_URL=https://api.korapay.com/merchant/api/v1

# =============================================================================
# EMAIL (SMTP)
# =============================================================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# =============================================================================
# SMS (Twilio)
# =============================================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# =============================================================================
# PUSH NOTIFICATIONS (Firebase)
# =============================================================================
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# =============================================================================
# WEBSOCKET
# =============================================================================
WS_HOST=localhost
WS_PORT=8000

# =============================================================================
# MCP SERVERS
# =============================================================================
MCP_SERVER_1_URL=http://localhost:8001
MCP_SERVER_1_API_KEY=your-mcp-api-key

# =============================================================================
# MONITORING
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin

# =============================================================================
# SSL (for nginx HTTPS)
# =============================================================================
SSL_CERT_PATH=/etc/ssl/certs/dutchkem.pem
SSL_KEY_PATH=/etc/ssl/private/dutchkem.key

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO

# =============================================================================
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60

# =============================================================================
# BACKUP (S3-compatible storage)
# =============================================================================
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# =============================================================================
# DOCKER PORTS (optional, for Docker Compose)
# =============================================================================
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
NGINX_SSL_PORT=443
DB_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
INFLUXDB_PORT=8086

# =============================================================================
# DOCKER PASSWORDS (for Docker Compose)
# =============================================================================
# RABBITMQ_USER=dutchkem
# RABBITMQ_PASS=dutchkem_mq_2024
# INFLUXDB_PASSWORD=dutchkem_influx_2024
