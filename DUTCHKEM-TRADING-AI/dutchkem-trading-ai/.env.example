# Dutchkem Trading AI — Environment Variables

# Django
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8080

# PostgreSQL
DB_USER=dutchkem
DB_PASSWORD=your-secure-password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dutchkem_trading

# Redis
REDIS_PASSWORD=your-redis-password
REDIS_HOST=localhost
REDIS_PORT=6379

# Celery (RabbitMQ)
RABBITMQ_USER=guest
RABBITMQ_PASS=your-rabbitmq-password

# InfluxDB
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=dutchkem
INFLUXDB_BUCKET=market_data
INFLUXDB_URL=http://localhost:8086

# MT5 (MetaTrader 5)
MT5_HOST=your-mt5-server-ip
MT5_PORT=1985
MT5_LOGIN=your-mt5-login
MT5_PASSWORD=your-mt5-password
MT5_SERVER=your-mt5-server

# WebSocket
WS_HOST=localhost
WS_PORT=8000

# Stripe (Payments)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# SMTP (Email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (Firebase)
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# MCP Servers
MCP_SERVER_1_URL=http://localhost:8001
MCP_SERVER_1_API_KEY=your-api-key

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Security
SSL_CERT_PATH=/etc/ssl/certs/dutchkem.pem
SSL_KEY_PATH=/etc/ssl/private/dutchkem.key

# Logging
LOG_LEVEL=INFO
LOG_FILE=/var/log/dutchkem/app.log

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Backup
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
