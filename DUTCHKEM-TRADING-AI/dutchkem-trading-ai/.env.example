# Dutchkem Trading AI — Environment Variables (RaidFrame / Railway)

# Django Core
SECRET_KEY=your-super-secret-key-change-this-in-production
DEBUG=False
DJANGO_SETTINGS_MODULE=config.settings_production
ALLOWED_HOSTS=*.railway.app,*.up.railway.app,dutchkem-trading-ai-production.up.railway.app
CSRF_TRUSTED_ORIGINS=https://dutchkem-trading-ai-production.up.railway.app

# PostgreSQL (Railway provides DATABASE_URL automatically)
DATABASE_URL=postgres://dutchkem:password@localhost:5432/dutchkem_trading

# Redis (Railway provides REDIS_URL automatically)
REDIS_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=https://dutchkem-trading-ai-frontend.up.railway.app,https://dutchkem-trading-ai-production.up.railway.app

# InfluxDB
INFLUXDB_URL=https://us-west-2-1.aws.cloud2.influxdata.com
INFLUXDB_TOKEN=your-influxdb-token
INFLUXDB_ORG=dutchkem
INFLUXDB_BUCKET=market_data

# MetaTrader 5
MT5_HOST=your-mt5-server-ip
MT5_PORT=1985
MT5_WS_PORT=3001
MT5_TIMEOUT=10
MT5_MAX_RETRIES=5
MT5_RETRY_DELAY=2.0

# Korapay (Payments)
KORA_SECRET_KEY=your-korapay-secret-key
KORA_ENCRYPTION_KEY=your-korapay-encryption-key
KORA_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_PUBLIC_KEY=your-korapay-public-key
KORA_WEBHOOK_SECRET=your-korapay-webhook-secret

# WebSocket
WS_HOST=localhost
WS_PORT=8000

# SMTP (Email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# SMS (Twilio)
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notifications (Firebase)
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# MCP Servers
MCP_SERVER_1_URL=http://localhost:8001
MCP_SERVER_1_API_KEY=your-api-key

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin

# Security
SSL_CERT_PATH=/etc/ssl/certs/dutchkem.pem
SSL_KEY_PATH=/etc/ssl/private/dutchkem.key

# Logging
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Backup
BACKUP_S3_BUCKET=your-backup-bucket
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
