# =============================================================================
# Dutchkem Trading AI — Cloud Environment Variables
# =============================================================================
# Copy this file to .env.cloud and fill in all values.
# This file is loaded by scripts/deploy-cloud.sh
#
# NEVER commit .env.cloud to git!
# =============================================================================

# ── Supabase ────────────────────────────────────────────────────────────────

SUPABASE_PROJECT_REF=your-project-ref-here
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-cli-access-token

# Database URL (Session mode from Supabase Dashboard > Settings > Database)
DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# ── Upstash Redis ───────────────────────────────────────────────────────────

UPSTASH_REDIS_REST_URL=https://your-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-token

# Same URL for Django, Celery, and Channels
REDIS_URL=https://your-instance.upstash.io
CELERY_BROKER_URL=https://your-instance.upstash.io

# ── Vercel ──────────────────────────────────────────────────────────────────

VERCEL_ORG_ID=your-org-id
VERCEL_PROJECT_ID=your-project-id

# ── Django (set in Render dashboard, not here) ──────────────────────────────
# These are set via `render env set` or in the Render dashboard:
#
# SECRET_KEY=<auto-generated by Render>
# DEBUG=0
# DJANGO_SETTINGS_MODULE=config.settings_prod
# ALLOWED_HOSTS=.onrender.com
# CORS_ALLOWED_ORIGINS=https://dutchkem-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=https://dutchkem-frontend.vercel.app
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True

# ── MetaTrader 5 (set in Render dashboard) ─────────────────────────────────
# MT5_HOST=127.0.0.1
# MT5_PORT=8082
# MT5_WS_PORT=8081
# MT5_MCP_URL=http://localhost:8082

# ── Payments (set in Render dashboard) ──────────────────────────────────────
# KORA_SECRET_KEY=
# KORA_PUBLIC_KEY=
# KORA_ENCRYPTION_KEY=
# KORA_WEBHOOK_SECRET=

# ── Cloudflare Tunnel (for MCP bridge — set up separately) ──────────────────
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
