# Dutchkem Trading AI — Dev Environment Variables
# Copy to .env and fill in values

# Django
SECRET_KEY=change-me-to-a-random-secret-key
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:80

# PostgreSQL
DB_USER=dutchkem_admin
DB_PASSWORD=dutchkem_secure_2024
DB_HOST=db
DB_PORT=5432
DB_NAME=dutchkem_trading

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# InfluxDB
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=dutchkem-influx-token-dev
INFLUXDB_ORG=dutchkem
INFLUXDB_BUCKET=trading_data
INFLUXDB_USER=admin
INFLUXDB_PASSWORD=dutchkem_influx_2024

# RabbitMQ
RABBITMQ_USER=dutchkem
RABBITMQ_PASS=dutchkem_mq_2024

# MetaTrader 5
MT5_HOST=host.docker.internal
MT5_PORT=3000

# Korapay (Payments)
KORA_SECRET_KEY=your-korapay-secret-key
KORA_ENCRYPTION_KEY=your-korapay-encryption-key
KORA_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_PUBLIC_KEY=your-korapay-public-key
KORA_WEBHOOK_SECRET=your-korapay-webhook-secret

# SMTP (Email)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_USE_TLS=True

# Monitoring
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_PASSWORD=admin

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000
NGINX_PORT=80
