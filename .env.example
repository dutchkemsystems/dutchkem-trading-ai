# =============================================================================
# Dutchkem Trading AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.

# --- Django Core ---------------------------------------------------------------
SECRET_KEY=replace-with-openssl-rand-hex-32
DEBUG=1
DJANGO_SETTINGS_MODULE=config.settings

# --- Database ------------------------------------------------------------------
# SQLite for local dev (no Docker needed)
USE_SQLITE=1

# PostgreSQL for production (set USE_SQLITE=0)
DATABASE_URL=postgresql://dutchkem:dutchkem_trading@localhost:5432/dutchkem_trading

# --- Redis / Celery ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MetaTrader 5 (SYNX-MT5-MCP bridge) ---------------------------------------
MT5_HOST=localhost
MT5_PORT=3000
MT5_WS_PORT=3001
MT5_TIMEOUT=10
MT5_MAX_RETRIES=5
MT5_RETRY_DELAY=2.0
MT5_MCP_URL=http://localhost:8080

# --- Cloudinary (media storage, optional) --------------------------------------
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- InfluxDB (time-series market data) ----------------------------------------
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=dutchkem
INFLUXDB_BUCKET=trading_data

# --- Payments (Korapay) -------------------------------------------------------
KORA_SECRET_KEY=
KORA_ENCRYPTION_KEY=
KORA_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_PUBLIC_KEY=
KORA_WEBHOOK_SECRET=

# --- CORS / Security -----------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
