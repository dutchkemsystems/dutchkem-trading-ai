# =============================================================================
# Dutchkem Trading AI — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# For production deployments, see DEPLOY_RENDER.md or the respective platform guide.

# --- Django Core ---------------------------------------------------------------
SECRET_KEY=replace-with-openssl-rand-hex-32
DEBUG=0
DJANGO_SETTINGS_MODULE=config.settings_production

# --- Database ------------------------------------------------------------------
# SQLite for local dev (no Docker needed)
USE_SQLITE=1

# PostgreSQL for production (set USE_SQLITE=0)
# Render auto-injects DATABASE_URL when linked to a PostgreSQL database.
DATABASE_URL=postgresql://dutchkem:dutchkem_trading@localhost:5432/dutchkem_trading

# --- Redis / Celery ------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- MetaTrader 5 (SYNX-MT5-MCP bridge) ---------------------------------------
# IMPORTANT: These are the Docker EXTERNAL mapped ports (not internal container ports).
# The bridge container maps 8082:8082 (REST) and 8081:8081 (WebSocket).
MT5_HOST=localhost
MT5_PORT=8082
MT5_WS_PORT=8081
MT5_TIMEOUT=10
MT5_MAX_RETRIES=5
MT5_RETRY_DELAY=2.0
MT5_MCP_URL=http://localhost:8082

# MT5 Terminal API (direct connection to MT5 terminal on host)
MT5_MT5_PORT=1929
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# --- Cloudinary (media storage, optional) --------------------------------------
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# --- InfluxDB (time-series market data) ----------------------------------------
INFLUXDB_URL=http://localhost:8086
INFLUXDB_TOKEN=
INFLUXDB_ORG=dutchkem
INFLUXDB_BUCKET=trading_data

# --- Payments (Korapay) -------------------------------------------------------
KORA_SECRET_KEY=
KORA_ENCRYPTION_KEY=
KORA_BASE_URL=https://api.korapay.com/merchant/api/v1
KORA_PUBLIC_KEY=
KORA_WEBHOOK_SECRET=

# --- CORS / Security -----------------------------------------------------------
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Production SSL (set to True on Render/Fly/Railway) ------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
